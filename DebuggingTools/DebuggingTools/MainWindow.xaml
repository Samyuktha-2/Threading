<Window x:Class="DebuggingTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DebuggingTools"
        xmlns:viewmodel="clr-namespace:DebuggingTools.ViewModel"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="450"
        Width="800">
    <Window.DataContext>
        <viewmodel:MainVM />
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
            <Button Content="Start1"
                    Command="{Binding StartWorkerCommand1}"
                    Width="200"
                    Height="200" />
            <TextBlock Text="{Binding Counter}"
                       Margin="20" />
        </StackPanel>
        <Button Content="Start2"
                Command="{Binding StartWorkerCommand2}"
                Width="200"
                Height="200"
                Grid.Column="1" />
    </Grid>
</Window>
