<Window x:Class="MiniCapstoneProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MiniCapstoneProject"
        xmlns:viewmodel="clr-namespace:MiniCapstoneProject.ViewModel"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="511.5"
        Width="800">
    <Window.DataContext>
        <viewmodel:MainVM />
    </Window.DataContext>
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Dashboard"
                       FontWeight="DemiBold"
                       HorizontalAlignment="Center"
                       Grid.Row="0"
                       FontSize="30" />

            <Button Content="Generate Job"
                    Grid.Row="0"
                    Command="{Binding GenerateJobCommand}" />
        </StackPanel>
        <DataGrid ItemsSource="{Binding Jobs}"
                  AutoGenerateColumns="False"
                  Grid.Row="1"
                  MaxColumnWidth="1000"
                  MinColumnWidth="260">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Id"
                                    Binding="{Binding Id}" />

                <DataGridTextColumn Header="File"
                                    Binding="{Binding FileName}" />

                <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status}" />

            </DataGrid.Columns>

        </DataGrid>

        <StackPanel Grid.Row="2">

            <StackPanel Margin="50 10 10 40">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Total Files Processed: "
                               Margin="10 5 0 10" />
                    <TextBlock Text="{Binding FilesProcessed}"
                               Margin="0 5 0 10" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Active Threads: "
                               Margin="10 5 0 10" />
                    <TextBlock Text="{Binding ActiveThreads}"
                               Margin="0 5 0 10" /> 
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Queue Count: "
                               Margin="10 5 0 10" />
                    <TextBlock Text="{Binding QueueCount}"
                               Margin="0 5 0 10" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="GC Count: "
                               Margin="10 5 0 10" />
                    <TextBlock Text="{Binding GCCount}"
                               Margin="0 5 0 10" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Parallel Scanning: "
                               Margin="10 5 0 10" />
                    <TextBlock Text="{Binding ScannedFiles}"
                               Margin="0 5 0 10" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Elapsed: "
                               Margin="10 5 0 10" />
                    <TextBlock Text="{Binding Elapsed}"
                               Margin="0 5 0 10" />
                </StackPanel> 
            </StackPanel> 

        </StackPanel>

    </Grid>
</Window>
