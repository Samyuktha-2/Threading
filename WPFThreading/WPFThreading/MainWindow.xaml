<Window x:Class="WPFThreading.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodel="clr-namespace:WPFThreading.ViewModel"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    
    <Window.DataContext>
        <viewmodel:MainModel />
    </Window.DataContext>
    
    <Grid Height="419"
          VerticalAlignment="Bottom">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <TextBlock Text="Running"
                   Name="textbox1"
                   Grid.Column="0"
                   Grid.Row="0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center" />

        <StackPanel Grid.Row="0"
                    Grid.Column="1">
            <Button VerticalAlignment="Top"
                    Content="start"
                    Width="50"
                    Click="Button_Click"
                    Name="btn1"
                    HorizontalAlignment="Center"
                    Margin="100 100 0 0" />
            <TextBlock Name="textblock3"
                       VerticalAlignment="Center"
                       Width="50"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Grid.Column="0">
            <Button VerticalAlignment="Top"
                    Content="start"
                    Width="50"
                    Click="Btn2_Click" 
                    Name="btn2"
                    HorizontalAlignment="Center"
                    Margin="50 50 0 0" />

            <TextBlock Name="textblock2" VerticalAlignment="Center" HorizontalAlignment="Center" Width="Auto" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Grid.Column="1">
            <Label HorizontalAlignment="Center" 
                   VerticalAlignment="Center" 
                   Name="ClockLbl" />

            <Button Content="Start" 
                    Click="Button_Click_1"/>

            <TextBlock Text="Using System.Timers.Timer" 
                       Margin="5 5 0 5"/>

            <Label HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Name="ClockLbl2" />

            <Button Content="Start"
                    Click="Button_Click_2" />

            <TextBlock Text="Using System.Threading.Timer"
                       Margin="5 5 0 5" />

            <Label HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Name="ClockLbl3" />

            <Button Content="Start"
                    Click="Button_Click_3" />
        </StackPanel>

        <StackPanel Grid.Row="0"
                    Grid.Column="2">
            <Label Content="{Binding TimerLabel}" Name="Lable1" Margin="10" FontSize="15"/>
            <Button Content="Start" Command="{Binding StartCommand}"/>
        </StackPanel>

    </Grid>
</Window>
