<Window x:Class="TimerExercise3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TimerExercise3"
        xmlns:viewmodel="clr-namespace:TimerExercise3.ViewModel"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="450"
        Width="800">
    <Window.DataContext>
        <viewmodel:MainVM />
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Employee Status: "
                           Margin="10 10 5 5" />
                <TextBlock Text="{Binding EmployeeStatus}"
                           Margin="0 10 5 5" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="GC Status: "
                           Margin="10 5 5 5" />
                <TextBlock Text="{Binding GCStatus}"
                           Margin="0 5 5 5" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Timer status: "
                           Margin="10 5 5 5" />
                <TextBlock Text="{Binding TimerStatus}"
                           Margin="0 5 5 5" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Weak Reference out of function: "
                           Margin="10 5 5 5" />
                <TextBlock Text="{Binding WeakReference1}"
                           Margin="0 5 5 5" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Weak Reference within function: "
                           Margin="10 5 5 5" />
                <TextBlock Text="{Binding WeakReference2}"
                           Margin="0 5 5 5" />
            </StackPanel>
            <Button Content="START"
                    Margin="20"
                    Command="{Binding StartCommand}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Grid.Column="1">
            <ItemsControl ItemsSource="{Binding TimerModel}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="3"
                                BorderBrush="Black"
                                Margin="5">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Tick Count: "
                                               Margin="10 5 5 5" />
                                    <TextBlock Text="{Binding TickCount}"
                                               Margin="0 5 5 5" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Elapsed time: "
                                               Margin="10 5 5 5" />
                                    <TextBlock Text="{Binding ElapsedTime}"
                                               Margin="0 5 5 5" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Current Thread: "
                                               Margin="10 5 5 5" />
                                    <TextBlock Text="{Binding CurrentThread}"
                                               Margin="0 5 5 5" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Threadlocal Count: "
                                               Margin="10 5 5 5" />
                                    <TextBlock Text="{Binding ThreadLocalCount}"
                                               Margin="0 5 5 5" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
